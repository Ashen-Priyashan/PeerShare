# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
/ui/node_modules/
/ui/dist/
/ui/.vite/
/desktop/app/frontend/node_modules/
/desktop/app/frontend/dist/*
!/desktop/app/frontend/dist/.gitkeep
/desktop/app/frontend/.vite/
/desktop/app/frontend/bindings/
/desktop/app/bin/
/desktop/app/wails_*.syso

# Local files served by a peer; keep test fixtures in dedicated tracked testdata directories.
/shared/

# Go workspace file
go.work
go.work.sum

# Local environment configuration
.env
.env.*
!.env.example

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
